{
  "version": 3,
  "port": 8080,
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "http://localhost:5173"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type"
      ],
      "expose_headers": [
        "Content-Length"
      ],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/restaurants",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/restaurants",
          "host": [
            "http://menu-service:8080"
          ],
          "is_collection": true,
          "mapping": {
            "collection": "restaurants"
          }
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/v1/orders",
          "host": [
            "http://order-service:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/v1/payments",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/v1/payments",
          "host": [
            "http://payment-service:8080"
          ]
        }
      ]
    }
  ]
}